# Read by Docker Compose on the host; this file is not mounted into the container.

# GHCR image tag for host deployment; latest tracks the newest stable release.
# Use a published version without the v prefix (e.g. 1.2.3) to select a release.
BMB_VERSION=latest

# BMW CarData Configurations
# BMW CarData client ID from the My BMW portal; required for authentication.
BMB_BMW_CLIENT_ID=
# BMW account ID / MQTT username; receives streams for vehicles linked to this account.
BMB_BMW_GCID=
# Optional:
# BMW CarData streaming MQTT hostname; normally keep the default.
#BMB_BMW_HOST=customer.streaming-cardata.bmwgroup.com
# BMW CarData streaming MQTT port (TLS); normally keep 9000.
#BMB_BMW_PORT=9000
# Seconds before reporting a BMW disconnect; avoids status flicker during token refresh. 0 reports immediately.
#BMB_BMW_STATUS_STABLE_DELAY=5

# Local MQTT Configuration
# Hostname or IP of your MQTT broker, without an mqtt:// or mqtts:// prefix.
BMB_MQTT_LOCAL_HOST=host.docker.internal
# Your MQTT broker port; typically 1883 without TLS or 8883 with TLS.
BMB_MQTT_LOCAL_PORT=1883
# Prefix for all forwarded MQTT topics and the bridge status topic.
BMB_MQTT_LOCAL_PREFIX=bmw/
# Client ID for your MQTT broker; use a unique value per instance, or leave empty for a generated ID.
BMB_MQTT_LOCAL_CLIENT_ID=
# Username for your MQTT broker; leave empty if authentication is not required.
BMB_MQTT_LOCAL_USER=
# Password for your MQTT broker; leave empty if authentication is not required.
BMB_MQTT_LOCAL_PASSWORD=
# true enables TLS encryption to your MQTT broker; false uses plain MQTT.
BMB_MQTT_LOCAL_TLS=false
# true checks the server certificate and hostname; false skips both checks (e.g. self-signed).
BMB_MQTT_LOCAL_TLS_VERIFY=true
# Container path to the trusted PEM CA/certificate file; used only when BMB_MQTT_LOCAL_TLS=true.
BMB_MQTT_LOCAL_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# 0 disables full JSON publishing on both RAW and Legacy topics; 1 enables it.
BMB_MQTT_RAW_TOPICS=1
# 0 disables per-field output; 1 publishes each field under <prefix>vehicles/<VIN>/<property>.
BMB_MQTT_SPLIT_TOPICS=1
# 1 additionally publishes Homie 4 devices/channels for openHAB discovery; independent of split topics.
# Homie descriptions and values are always retained, regardless of BMB_MQTT_RETAIN.
BMB_MQTT_HOMIE=0
# 1 retains the latest forwarded payload on each topic; 0 disables retention. Status is always retained.
BMB_MQTT_RETAIN=0

# Optional:
# Seconds of continuous downtime allowed per MQTT connection before healthchecks fail; must be positive.
#BMB_HEALTH_MQTT_DISCONNECT_TIMEOUT=120
